# Local development only; use this value for an existing volume from main.
# For Volta, provision a separate server-only env using docs/volta-env-requirements.md.
# compose.prod.yaml fixes the HTTPS origins and requires explicit storage paths,
# CPU/RAM budgets, PostgreSQL/S3/Elasticsearch credentials and TLS SMTP.
# Use a URL-safe password. Changing it does NOT change an existing DB role.
POSTGRES_PASSWORD=srez_dev
# Base compose.yaml only. Integration uses DB port 15432; do not load this URL into native Go for integration.
# Docker Compose always supplies its own db hostname:
DATABASE_URL=postgres://srez:srez_dev@localhost:5432/srez?sslmode=disable

# Standalone Go: use the URL of a reachable Elasticsearch instance.
# Integration Compose supplies its internal service URL.
SREZ_ELASTICSEARCH_URL=
SREZ_ELASTICSEARCH_USERNAME=
SREZ_ELASTICSEARCH_PASSWORD=

# Generate independently: openssl rand -base64 32 (no fallback secrets).
SREZ_JWT_KEY=
SREZ_CSRF_KEY=
# Stable independent key for encrypted wishlist links. Preserve across restarts.
SREZ_WISHLIST_KEY=
SREZ_JWT_ISSUER=srez
SREZ_JWT_AUDIENCE=srez-api
SREZ_PUBLIC_ORIGIN=http://127.0.0.1:8080
# Explicit development only; production requires HTTPS and false.
SREZ_AUTH_LOCAL_HTTP=true
SREZ_AUTH_ATTEMPTS=10
SREZ_AUTH_HASH_WORKERS=2
SREZ_TRUSTED_PROXIES=

# Generate independently, e.g. openssl rand -hex 20 / openssl rand -hex 32.
# Never put these values in frontend configuration or commit .env.
SREZ_S3_ACCESS_KEY=
SREZ_S3_SECRET_KEY=
# Go outside Docker; Compose uses seaweedfs for internal API calls.
SREZ_S3_ENDPOINT=http://127.0.0.1:8333
SREZ_S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
SREZ_S3_REGION=us-east-1
SREZ_S3_BUCKET=srez-media

# Local SMTP: Compose uses mailpit:1025; native Go uses loopback.
SREZ_SMTP_HOST=127.0.0.1
SREZ_SMTP_PORT=1025
SREZ_MAIL_FROM=SREZ <no-reply@srez.local>
SREZ_FRONTEND_BASE_URL=http://localhost:5174
# none only for local Mailpit; provider requires starttls or tls.
SREZ_SMTP_TLS=none
SREZ_SMTP_USERNAME=
SREZ_SMTP_PASSWORD=
