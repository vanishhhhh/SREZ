# Local development only; use this value for an existing volume from main.
# Use a URL-safe password. Changing it does NOT change an existing DB role.
POSTGRES_PASSWORD=srez_dev
# For Go outside Docker (Compose supplies its own db hostname):
DATABASE_URL=postgres://srez:srez_dev@localhost:5432/srez?sslmode=disable

# Generate independently: openssl rand -base64 32 (no fallback secrets).
SREZ_JWT_KEY=
SREZ_CSRF_KEY=
SREZ_JWT_ISSUER=srez
SREZ_JWT_AUDIENCE=srez-api
SREZ_PUBLIC_ORIGIN=http://127.0.0.1:8080
# Explicit development only; production requires HTTPS and false.
SREZ_AUTH_LOCAL_HTTP=true
SREZ_AUTH_ATTEMPTS=10
SREZ_AUTH_HASH_WORKERS=2
SREZ_TRUSTED_PROXIES=
