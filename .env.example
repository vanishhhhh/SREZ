# Local development only; use this value for an existing volume from main.
# Use a URL-safe password. Changing it does NOT change an existing DB role.
POSTGRES_PASSWORD=srez_dev
SREZ_DEV_CATALOG_WRITE=false
# For Go outside Docker (Compose supplies its own db hostname):
DATABASE_URL=postgres://srez:srez_dev@localhost:5432/srez?sslmode=disable
